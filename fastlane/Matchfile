# Matchfile for fastlane match
# Docs: https://docs.fastlane.tools/actions/match/

git_url ENV["MATCH_GIT_URL"] || "https://github.com/Adam-Blf/certificates.git"

storage_mode "git"
username ENV["FASTLANE_APPLE_ID"] || "adam.beloucif@efrei.net"
team_id ENV["FASTLANE_TEAM_ID"] || "XXXXXXXXXX"

app_identifier ["com.beloucif.blackout"]
type "appstore"
readonly ENV["MATCH_READONLY"] != "false"  # Default true in CI, false locally for creating new certs

# Passwords
git_basic_authorization ENV["MATCH_GIT_BASIC_AUTH"] || ""
match_password ENV["MATCH_PASSWORD"] || ""
