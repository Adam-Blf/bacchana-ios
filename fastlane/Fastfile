default_platform(:ios)

platform :ios do
  # Generate Xcode project from project.yml
  before_all do
    setup_ci if is_ci
  end

  desc "Run tests on simulator (CI)"
  lane :test do
    setup_ci if is_ci

    # Generate Xcode project
    sh("xcodegen generate")

    # Run tests on simulator
    scan(
      project: "BlackOut.xcodeproj",
      scheme: "BlackOut",
      destination: "generic/platform=iOS Simulator",
      clean: true,
      skip_package_ipa: true,
      skip_package_pkg: true
    )
  end

  desc "Build app for simulator (dev)"
  lane :build_simulator do
    sh("xcodegen generate")

    build_app(
      project: "BlackOut.xcodeproj",
      scheme: "BlackOut",
      configuration: "Release",
      destination: "generic/platform=iOS Simulator",
      skip_package_ipa: true,
      skip_package_pkg: true,
      code_signing_allowed: false
    )
  end

  desc "Build and upload to TestFlight (internal testing)"
  lane :beta do
    setup_ci if is_ci

    # Generate Xcode project
    sh("xcodegen generate")

    # Fetch or create signing certificates via match
    match(
      type: "appstore",
      readonly: is_ci,
      app_identifier: "com.beloucif.blackout"
    ) if ENV["MATCH_GIT_URL"]

    # Build IPA for App Store
    build_app(
      project: "BlackOut.xcodeproj",
      scheme: "BlackOut",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      code_signing_identity: "Apple Distribution: Adam Beloucif (XXXXXXXXXX)",
      provisioning_profile_specifier: "match AppStore com.beloucif.blackout",
      clean: true,
      output_directory: "build"
    )

    # Upload to TestFlight
    upload_to_testflight(
      app_identifier: "com.beloucif.blackout",
      ipa: "build/BlackOut.ipa",
      skip_waiting_for_build_processing: false,
      skip_submission: true
    )

    slack(
      message: "Beta build uploaded to TestFlight",
      success: true
    ) if ENV["SLACK_WEBHOOK"]
  end

  desc "Build and submit to App Store for review"
  lane :release do
    setup_ci if is_ci

    sh("xcodegen generate")

    # Fetch signing certificates
    match(
      type: "appstore",
      readonly: is_ci,
      app_identifier: "com.beloucif.blackout"
    ) if ENV["MATCH_GIT_URL"]

    # Build IPA
    build_app(
      project: "BlackOut.xcodeproj",
      scheme: "BlackOut",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      code_signing_identity: "Apple Distribution: Adam Beloucif (XXXXXXXXXX)",
      provisioning_profile_specifier: "match AppStore com.beloucif.blackout",
      clean: true,
      output_directory: "build"
    )

    # Submit to App Store for review
    deliver(
      app_identifier: "com.beloucif.blackout",
      ipa: "build/BlackOut.ipa",
      skip_screenshots: true,
      skip_metadata: false,
      automatic_release: false,
      force: false,
      submit_for_review: true,
      submission_information: {
        export_compliance_encryption_updated: false,
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )

    slack(
      message: "Release submitted to App Store for review",
      success: true
    ) if ENV["SLACK_WEBHOOK"]
  end

  desc "Download provisioning profiles and certificates from match (manual)"
  lane :sync_certs do
    match(
      type: "appstore",
      readonly: false,
      app_identifier: "com.beloucif.blackout",
      force: false
    )
  end

  error do |lane, exception|
    slack(
      message: "Lane #{lane} failed: #{exception}",
      success: false
    ) if ENV["SLACK_WEBHOOK"]
  end
end
